# FitMate TikTok App Events SDK v1.5.0
# Copy this file to android/tiktok.properties and fill values from TikTok Events Manager.
# android/tiktok.properties is gitignored.
#
# IMPORTANT: Do NOT put TikTok App Secret in this file or anywhere in the APK.

