# The URL of a deployed FitMate staging app, never production.
FITMATE_E2E_TARGET=staging
FITMATE_E2E_BASE_URL=https://fitmate-staging.example.com

# Dedicated staging test account.
FITMATE_E2E_EMAIL=fitmate-e2e@example.com
FITMATE_E2E_PASSWORD=replace-with-a-strong-test-password

# Separate Supabase staging project.
FITMATE_E2E_SUPABASE_URL=https://your-staging-project.supabase.co
FITMATE_E2E_SUPABASE_ANON_KEY=your-staging-anon-or-publishable-key
FITMATE_E2E_SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key

# Paid AI generation remains opt-in.
FITMATE_E2E_RUN_AI=false

NEXT_PUBLIC_FITMATE_SUPPORT_EMAIL=support@your-domain.com

# Xendit test-mode subscription setup for staging.
FITMATE_APP_URL=https://fitmate-staging.example.com
NEXT_PUBLIC_APP_URL=https://fitmate-staging.example.com
XENDIT_SECRET_KEY=xnd_development_your-test-secret-key
XENDIT_WEBHOOK_TOKEN=your-staging-webhook-verification-token

# Jogging map tiles. For production traffic, use a provider that fits your usage.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION="© OpenStreetMap contributors"
