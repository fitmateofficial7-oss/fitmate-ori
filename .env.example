# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Use either the legacy anon key or the newer publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=your-openai-api-key

# Optional model overrides. The selected models must support the Responses API;
# the vision model must also accept image input.
OPENAI_MODEL=gpt-5.6
# OPENAI_PLAN_MODEL=gpt-5.6
# OPENAI_FALLBACK_MODEL=gpt-4.1-mini
# OPENAI_COACH_MODEL=gpt-5.6
# OPENAI_VISION_MODEL=gpt-5.6

# Comma-separated accounts that may open /admin/monitoring.
FITMATE_ADMIN_EMAILS=admin@example.com

# Optional current model prices used only for the monitoring cost estimate.
# Enter USD per 1,000,000 input/output tokens and update them when prices change.
# FITMATE_AI_INPUT_USD_PER_1M=0
# FITMATE_AI_OUTPUT_USD_PER_1M=0

# Public support contact used by Privacy/Delete Account pages
NEXT_PUBLIC_FITMATE_SUPPORT_EMAIL=support@your-domain.com

# Public canonical FitMate URL. Required for Xendit return URLs.
FITMATE_APP_URL=https://fitmate.example.com
NEXT_PUBLIC_APP_URL=https://fitmate.example.com

# Xendit server credentials. Keep both values server-only.
# Start with Test Mode (xnd_development_) and use the callback token shown in
# Dashboard > Settings > Webhooks. See XENDIT_SETUP_INDONESIA.md.
XENDIT_SECRET_KEY=xnd_development_your-secret-key
XENDIT_WEBHOOK_TOKEN=your-xendit-webhook-verification-token

# Jogging map tiles. For production traffic, use a provider that fits your usage.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION="© OpenStreetMap contributors"

# Hosted HTTPS FitMate URL loaded by the Android/iOS Capacitor shell.
CAPACITOR_SERVER_URL=https://your-fitmate-domain.com
